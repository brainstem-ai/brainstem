{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@brainstem/core": ["./packages/core/src/index.ts"],
      "@brainstem/pi-adapter": ["./packages/pi-adapter/src/index.ts"],
      "@brainstem/reflexes": ["./packages/reflexes/src/index.ts"],
      "@brainstem/reflexes/*": ["./packages/reflexes/src/*"]
    },
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["experiments", "packages/*/src", "packages/*/test", "tsdown.config.ts", "tsdown.check.config.ts", "vitest.config.ts"]
}
